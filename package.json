{
  "name": "catlists-ico",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:api": "node --watch server/index.js",
    "dev:web": "ng serve --host 0.0.0.0",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "build": "ng build",
    "check": "node --check server/index.js && node --check server/routes/api.js",
    "test": "npm run test:api && npm run test:contract",
    "test:api": "node --test server/routes/api.test.js",
    "contract:compile": "hardhat build",
    "test:contract": "hardhat test"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.3",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@openzeppelin/contracts": "^5.6.1",
    "chai": "^5.2.0",
    "concurrently": "^9.1.2",
    "ethers": "^6.17.0",
    "hardhat": "3.20.0",
    "mocha": "^12.0.0",
    "solc": "0.8.37",
    "typescript": "~6.0.3"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-win32-x64-msvc": "0.150.0",
    "@nomicfoundation/edr-win32-x64-msvc": "0.23.0"
  },
  "overrides": {
    "vite": "8.3.3",
    "tmp": "0.2.7"
  }
}
